{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make info)",
      "Bash(make check-git)"
    ],
    "ask": [
      "Bash(make setup)",
      "Bash(make all)",
      "Bash(make clean)",
      "Bash(make set-git-local)",
      "Bash(make install-hooks)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
